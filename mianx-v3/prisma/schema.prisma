generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ToolRiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
}

enum Role {
  USER
  ADMIN
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  TRIALING
  UNPAID
}

enum MissionStatus {
  DRAFT
  PLANNING
  EXECUTING
  VERIFYING
  REPAIRING
  COMPLETED
  FAILED
  CANCELLED
}

enum TaskRiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum OutcomeStatus {
  NOT_STARTED
  IN_PROGRESS
  NEAR_TARGET
  ACHIEVED
  FAILED
}

enum AgentRiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum MissionTaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
  SKIPPED
}

model User {
  id              String             @id @default(cuid())
  email           String             @unique
  name            String?
  passwordHash    String?
  role            Role               @default(USER)
  organizationId  String?
  organization    Organization?      @relation(fields: [organizationId], references: [id])
  accounts        Account[]
  sessions        Session[]
  webhookEvents   WebhookEvent[]
  missions        Mission[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  @@map("users")
}

model Organization {
  id          String   @id @default(cuid())
  name        String
  aiCredits   Int      @default(1000)
  plan        String   @default("free")
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@map("organizations")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("sessions")
}

model WebhookEvent {
  id            String              @id @default(cuid())
  stripeEventId String              @unique
  type          String
  status        WebhookEventStatus @default(RECEIVED)
  payload       String
  processedAt   DateTime?
  error         String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  userId        String?
  user          User?               @relation(fields: [userId], references: [id])
  @@map("webhook_events")
}

model Subscription {
  id                String             @id @default(cuid())
  userId            String
  stripeCustomerId  String
  stripePriceId     String
  stripeSubId       String             @unique
  status            SubscriptionStatus
  currentPeriodEnd  DateTime
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  @@map("subscriptions")
}

model Agent {
  id            String          @id @default(cuid())
  name          String          @unique
  role          String
  capabilities  Json
  allowedTools  Json
  riskLevel     AgentRiskLevel  @default(MEDIUM)
  costProfile   Float          @default(0)
  isActive      Boolean        @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  @@map("agents")
}

model Tool {
  id           String        @id @default(cuid())
  name         String        @unique
  description  String
  inputSchema  Json
  outputSchema Json
  riskLevel    ToolRiskLevel @default(MEDIUM)
  isEnabled    Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  @@map("tools")
}

model Mission {
  id              String         @id @default(cuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  rawGoal         String
  normalizedGoal  String
  status          MissionStatus  @default(DRAFT)
  complexity      String         @default("MEDIUM")
  successCriteria Json
  budget          Float          @default(0)
  budgetUsed      Float          @default(0)
  tasks           MissionTask[]
  outcome         Outcome?
  auditLogs       AuditLog[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  @@map("missions")
}

model MissionTask {
  id             String            @id @default(cuid())
  missionId      String
  mission        Mission           @relation(fields: [missionId], references: [id], onDelete: Cascade)
  title          String
  agent          String
  dependencies   String
  riskLevel      TaskRiskLevel     @default(MEDIUM)
  status         MissionTaskStatus @default(PENDING)
  result         String?
  error          String?
  sortOrder      Int               @default(0)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  @@map("mission_tasks")
}

model Outcome {
  id        String        @id @default(cuid())
  missionId String        @unique
  mission   Mission       @relation(fields: [missionId], references: [id], onDelete: Cascade)
  baseline  Float
  target    Float
  current   Float         @default(0)
  status    OutcomeStatus @default(NOT_STARTED)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  @@map("outcomes")
}

model AuditLog {
  id         String   @id @default(cuid())
  missionId  String
  mission    Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)
  agentName  String
  action     String
  result     String
  cost       Float    @default(0)
  createdAt  DateTime @default(now())
  @@map("audit_logs")
}

model Deliverable {
  id              String   @id @default(cuid())
  projectId       String
  name            String
  content         String
  contentEncoding String   @default("base64")
  mimeType        String   @default("application/octet-stream")
  storageUrl      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@map("deliverables")
}

model DomainPack {
  id        String   @id @default(cuid())
  packId    String   @unique
  name      String
  version   String
  manifest  Json
  isEnabled Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("domain_packs")
}

model CountryPack {
  id        String   @id @default(cuid())
  packId    String   @unique
  name      String
  locale    String
  currency  String
  manifest  Json
  isEnabled Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("country_packs")
}

model AiUsageLog {
  id             String   @id @default(cuid())
  userId         String
  organizationId String?
  tokensUsed     Int
  model          String
  createdAt      DateTime @default(now())
  @@map("ai_usage_logs")
}
