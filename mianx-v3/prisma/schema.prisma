generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum ToolRiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
}

enum Role {
  USER
  ADMIN
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  TRIALING
  UNPAID
}

enum MissionStatus {
  DRAFT
  PLANNING
  EXECUTING
  VERIFYING
  REPAIRING
  COMPLETED
  FAILED
  CANCELLED
}

enum TaskRiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum OutcomeStatus {
  NOT_STARTED
  IN_PROGRESS
  NEAR_TARGET
  ACHIEVED
  FAILED
}

enum AgentRiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum MissionTaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
  SKIPPED
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id              String             @id @default(cuid())
  email           String             @unique
  name            String?
  role            Role               @default(USER)
  organizationId  String?
  organization    Organization?      @relation(fields: [organizationId], references: [id])
  accounts        Account[]
  sessions        Session[]
  webhookEvents   WebhookEvent[]
  missions       Mission[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

model Organization {
  id          String   @id @default(cuid())
  name        String
  aiCredits   Int      @default(1000)
  plan        String   @default("free")
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WebhookEvent {
  id            String              @id @default(cuid())
  stripeEventId String              @unique
  type          String
  status        WebhookEventStatus @default(RECEIVED)
  payload       String
  processedAt   DateTime?
  error         String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  userId        String?
  user          User?               @relation(fields: [userId], references: [id])
}

model Subscription {
  id                String             @id @default(cuid())
  userId            String
  stripeCustomerId  String
  stripePriceId     String
  stripeSubId       String             @unique
  status            SubscriptionStatus
  currentPeriodEnd  DateTime
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model Agent {
  id            String          @id @default(cuid())
  name          String          @unique           // e.g. "Atlas", "Zen"
  role          String                            // e.g. "Backend Developer"
  capabilities  Json                              // Array of strings e.g. ["API", "Database", "Auth"]
  allowedTools  Json                              // Array of tool IDs/names this agent can use
  riskLevel     AgentRiskLevel  @default(MEDIUM)
  costProfile   Float          @default(0)       // estimated cost per task
  isActive      Boolean        @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model Tool {
  id           String        @id @default(cuid())
  name         String        @unique
  description  String
  inputSchema  Json          // Zod-compatible schema definition
  outputSchema Json          // Expected output structure
  riskLevel    ToolRiskLevel @default(MEDIUM)
  isEnabled    Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Mission {
  id              String         @id @default(cuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  rawGoal         String         // The user's original natural-language input
  normalizedGoal  String         // Parsed, clean objective
  status          MissionStatus  @default(DRAFT)
  complexity      String         @default("MEDIUM")  // LOW, MEDIUM, HIGH
  successCriteria Json           // Array of measurable criteria
  budget          Float          @default(0)
  budgetUsed      Float          @default(0)
  tasks           MissionTask[]
  outcome         Outcome?
  auditLogs       AuditLog[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model MissionTask {
  id             String            @id @default(cuid())
  missionId      String
  mission        Mission           @relation(fields: [missionId], references: [id], onDelete: Cascade)
  title          String
  agent          String            // e.g. "Atlas", "Zen"
  dependencies   String            // JSON array of dependency task titles
  riskLevel      TaskRiskLevel     @default(MEDIUM)
  status         MissionTaskStatus @default(PENDING)
  result         String?           // Output / artifact reference when completed
  error          String?           // Error message if failed
  sortOrder      Int               @default(0)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

model Outcome {
  id        String        @id @default(cuid())
  missionId String        @unique
  mission   Mission       @relation(fields: [missionId], references: [id], onDelete: Cascade)
  baseline  Float
  target    Float
  current   Float         @default(0)
  status    OutcomeStatus @default(NOT_STARTED)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  missionId  String
  mission    Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)
  agentName  String
  action     String
  result     String
  cost       Float    @default(0)
  createdAt  DateTime @default(now())
}

model Deliverable {
  id              String   @id @default(cuid())
  projectId       String
  name            String
  content         String   // BUG: stores base64 data — will be migrated to storageUrl
  contentEncoding String   @default("base64") // BUG: no longer needed after migration
  mimeType        String   @default("application/octet-stream") // BUG: no longer needed after migration
  storageUrl      String?  // Will replace `content` after migration
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model DomainPack {
  id        String   @id @default(cuid())
  packId    String   @unique
  name      String
  version   String
  manifest  Json     // Full DomainPackManifest
  isEnabled Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CountryPack {
  id        String   @id @default(cuid())
  packId    String   @unique
  name      String
  locale    String
  currency  String
  manifest  Json     // Full CountryPackManifest
  isEnabled Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AiUsageLog {
  id              String   @id @default(cuid())
  userId          String
  organizationId  String?
  tokensUsed      Int
  model           String
  createdAt       DateTime @default(now())
}
